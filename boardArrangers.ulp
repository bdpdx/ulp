void arrangeHumiditySensor() {
	real x = 106.5;
	real y = 24;

	move("U47", x, y);
	move("C41", x + 3, y - 1);

	addVia("GND", x - 2, y);
	addVia("GND", x, y - 1.5);
	addVia("GND", x + 1, y + 1.5);
	addVia("GND", x + 2, y + 0.5);
	addVia("GND", x + 3.5, y + 0.5);

	addVia("3.3V", x + 1, y - 1.5);
}

void arrangePumpSwitchesPart2() {
	int i;
	real x;
	real y;

	x = 21.1;
	y = 23.775;

	for (i = 0; i < 2; ++i) {
		for (int j = 0; j < 4; ++j) {
			int qA = i * 8 + 7 + j;
			int qB = i * 8 + 11 + j;
			int rA = i * 12 + 80 + j;
			int rB = i * 12 + 88 + j;

			printf("*** %d, %d, Q%d, Q%d, R%d, R%d\n", i, j, qA, qB, rA, rB);

// 			int level = (i * 4 + j) / 2;
// 			y -= 8 * level;		

			string part;

			sprintf(part, "Q%d", qA);
			move(part, x, y);
			sprintf(part, "Q%d", qB);
			move(part, x - 5.72, y + 0.74);
			sprintf(part, "R%d", rA);
			move(part, x - 5.22, y - 1.29);
			sprintf(part, "R%d", rB);
			move(part, x - 4.77, y + 3.27);
			
			x += 16;
		}
	}
}

