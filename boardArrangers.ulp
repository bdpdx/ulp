}

void arrangeShiftRegister(string u, real x, real y, string c) {
	move(u, x, y);
	rotate(c, 270);
	move(c, x - 6.5, y + 2);
	
	addPowerVia("GND", x - 6.5, y);
	addPowerVia("GND", x + 4.4	, y - 1.5);
}

