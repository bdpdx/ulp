void arrange33VLDO() {
	rotate("C3", 270);
	rotate("C4", 270);
	rotate("U2", 90);	// U2 is 3.3V LDO

	real x = 117;
	real y = 130;
	
	move("U2", x, y);
	x += 5;
	y += 2;
	move("C3", x, y);
	y -= 3.5;
	move("C4", x, y);

	addPowerVia("3.3V", 115.5, 130);
	addPowerVia("3.3V", 118.5, 130);
	addPowerVia("3.3V", 123.5, 129);

	// heat sink connections
	addPowerVia("3.3V", 66, 129.9);
	addPowerVia("3.3V", 85, 129.9);
	addPowerVia("3.3V", 104, 129.9);

	addPowerVia("GND", 118.5, 127.75);
	addPowerVia("GND", 123.5, 131.5);
	addPowerVia("GND", 122, 126.5);
}

