	arrangeShiftRegister("U7", x, y, "C33");
	arrangeShiftRegister("U8", x += xOffset, y, "C34");
	arrangeShiftRegister("U9", x += xOffset, y, "C35");
	arrangeShiftRegister("U10", x += xOffset, y, "C36");
	arrangeShiftRegister("U11", x += xOffset, y, "C37");
}

