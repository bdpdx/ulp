void arrangeDCDCSupply() {
	rotate("F1", 90);
	move("F1", 11, 144.5);
	addPowerVia("24VAC+", 11, 145);

	rotate("C6", 90);
	move("C6", 14.75, 143.5);
	addPowerVia("GND", 14.75, 147);

	move("D1", 14.75, 127.5);
	move("SW1", 5.5, 127);
	
	rotate("Q1", 180);
	move("Q1", 14.75, 122.5);

	rotate("C7", 90);
	move("C7", 10, 123.5);
	addVia("GND", 10, 125.5);
	
	rotate("C8", 90);
	move("C8", 12, 123.5);
	addVia("GND", 12, 125.5);
	
	rotate("R5", 180);
	move("R5", 10.5, 121);
	addVia("GND", 12.25, 121);

	rotate("R6", 180);
	move("R6", 10.5, 118.5);
	addVia("GND", 12.25, 118.5);

	rotate("D2", 180);
	move("D2", 14, 117.5);
	addVia("GND", 15.5, 117.5);

	rotate("D3", 180);
	move("D3", 14, 120);
	addVia("GND", 15.5, 120);

	rotate("D4", 180);
	move("D4", 14, 119);
	addVia("GND", 15.5, 119);

	rotate("J1", 180);
	move("J1", 7.5, 136);

	rotate("J2", 270);
	move("J2", 3, 120);
	
	rotate("U1", 180);
	move("U1", 29.5, 121);
	move("U3", 29.5, 136.5);

	rotate("R4", 90);
