void arrangeShiftRegistersPart2() {
	real x = 37;
	real y = 104.5;

	for (int i = 6; i <= 10; ++i) {
		string cPart, uPart;
		sprintf(uPart, "U%d", i);
		sprintf(cPart, "C%d", i + 5);
	
		move(uPart, x, y);
		move(cPart, x - 6.5, y + 2.1);
		
		x += 16.5;
	}
}

