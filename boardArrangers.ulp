real cuiDevicesTerminalBlockHorizontalDistanceBetweenPins = 5.08;
real cuiDevicesTerminalBlockPin1OffsetX = 2.6;
real cuiDevicesTerminalBlockHeight = 14.05;

real cuiDevicesTerminalBlockWidth(int numberOfTerminals) {
	return 5.08 * numberOfTerminals + 2.5;	// from datasheet
}

real esp32Height = 31.5;
real esp32Width = 19.2;
real j4OffsetX = 10;
real j4OffsetY = 1;
real mountingHoleDiameter = 7.366; // diameter includes keepout
real mountingHoleInset = 4.5;

void arrangeAtlasDevices() {
	// parts layout is left to right
	// U44 is conductivity, U45 is ph, U46 is temperature
	string parts[] = { "U44", "U45", "U46" };

	real distanceToMountingHole = 1;
	real partHeight = 39.2;
	real partWidth = 18.4;
	real xOffset = ceil(partWidth);
//  	real x = boardWidth - mountingHoleInset - mountingHoleDiameter / 2 - distanceToMountingHole - partWidth / 2;
	real x = 104;
	real y = boardHeight - minimumBoardEdgeMargin - partHeight / 2;
	
	for (int i = 3; i--;) {
		rotate(parts[i], 180);
		move(parts[i], x, y);
		x -= xOffset;
	}
	
	rotate("R156", 270);
	move("R156", 92.5, 112);
}

