string findMOC3063Neighbors(UL_ELEMENT moc3063) {
	string result;

	if (!project.schematic) {
		printf("please open a schematic\n");
		return result;
	}

	string gateResistor;
	string led;
	string pin1Net, pin2Net, pin6Net;
	string triacName;
	
	project.schematic(s) {
		s.allnets(n) {
			n.pinrefs(p) {
				if (strcmp(p.part.name, moc3063.name)) continue;

				switch (strtol(p.pin.name)) {
					case 1:		pin1Net = n.name;	break;
					case 2:		pin2Net = n.name;	break;
					case 6:		pin6Net = n.name;	break;
				}

				if (pin1Net && pin2Net && pin6Net) break;
			}
		}
		
		s.allnets(n) {
			if (!strcmp(n.name, pin2Net)) {
				// the net between Pin 2 and the indicator LED is anonymous and
				// nothing else is connected to this net
				n.pinrefs(p) {
					if (strcmp(p.part.name, moc3063.name)) {
// 						printf("found LED %s connected via %s to moc3063 %s\n", p.part.name, n.name, moc3063.name);
						led = p.part.name;
					}
				}
			} else if (!strcmp(n.name, pin6Net)) {
				// the net between Pin 6 and the triac gate resistor is anonymous and
				// nothing else is connected to this net
				n.pinrefs(p) {
					if (strcmp(p.part.name, moc3063.name)) {
// 						printf("found resistor %s connected via %s to moc3063 %s\n", p.part.name, n.name, moc3063.name);
						gateResistor = p.part.name;
					}
				}
			}
			
			if (led && gateResistor) break;
		}
		
		string triacNet;
		
		s.allnets(n) {
			n.pinrefs(p) {
				if (strcmp(p.part.name, gateResistor)) continue;
				if (strcmp(n.name, pin6Net)) {
					triacNet = n.name;
// 					printf("triac net is %s\n", triacNet);
					break;
				}
			}
			
			if (triacNet) break;
		}
		
		s.allnets(n) {
			if (strcmp(n.name, triacNet)) continue;
			
			n.pinrefs(p) {
				if (strcmp(p.part.name, gateResistor)) {
					triacName = p.part.name;
// 					printf("triac name is %s\n", triacName);
					break;
				}
			}
			
			if (triacName) break;
		}
	}
	
	result = gateResistor + "," + led + "," + pin1Net + "," + triacName;
	
	return result;
}

void arrangeSolenoidTriggerComponentsPart1() {
	// rotate solenoid triacs 90
	string partNames = partNamesWithPrefixInRangeSeparatedByNewline("T", 1, 32);
	
	rotateParts(partNames, 90);
}

void arrangeSolenoidTriggerComponentsPart2() {
// 	addCommand("ripup");
	int columns = 8;
	int rows = 4;

	real moc3063CenterX = 13; // align left edge with terminal blocks
	real moc3063CenterY = 100;

	real gateResistorOffsetX = 4.7;
	real gateResistorOffsetY = 2;
	real triacOffsetX = 6.5;
	real triacOffsetY = -1;
	real ledResistorOffsetX = 4.7;
	real ledResistorOffsetY = -2;
	real columnOffsetX = 17.5;
	real rowOffsetY = -12;
	real moc24VACViaOffsetX = 4.4;
	real moc24VACViaOffsetY = 4.5;
	real triac24VACViaOffsetX = 5.5;
	real triac24VACViaOffsetY = 0;

	int moc3063BasePartNumber = 12;

	for (int i = 0; i < columns; ++i) {
		for (int j = 0; j < rows; ++j) {
			string moc3063Name;
			sprintf(moc3063Name, "U%d", moc3063BasePartNumber++);
		
			UL_ELEMENT moc3063 = findBoardPartNamed(moc3063Name);
			string neighborsString = findMOC3063Neighbors(moc3063);
			string neighbors[];

			if (strsplit(neighbors, neighborsString, ',') != 4) {
				printf("neighbors of %s:%s not found\n", moc3063.name, moc3063.value);
				return;
			}

			UL_ELEMENT gateResistor = findBoardPartNamed(neighbors[0]);
			UL_ELEMENT ledResistor = findBoardPartNamed(neighbors[1]);
			UL_ELEMENT triac = findBoardPartNamed(neighbors[3]);
		
			real moc3063x = moc3063CenterX + i * columnOffsetX;
			real moc3063y = moc3063CenterY + j * rowOffsetY;

			move(moc3063Name, moc3063x, moc3063y);
			
			rotate(ledResistor.name, 270);
			move(ledResistor.name, moc3063x + ledResistorOffsetX, moc3063y + ledResistorOffsetY);
			addVia("GND", moc3063x + ledResistorOffsetX, moc3063y);

			move(triac.name, moc3063x + triacOffsetX, moc3063y + triacOffsetY);
			addPowerVia("24VAC+", moc3063x + triacOffsetX + triac24VACViaOffsetX, moc3063y + triacOffsetY + triac24VACViaOffsetY);
			
			rotate(gateResistor.name, 270);
			move(gateResistor.name, moc3063x + gateResistorOffsetX, moc3063y + gateResistorOffsetY);

			addPowerVia("24VAC+", moc3063x + moc24VACViaOffsetX, moc3063y + moc24VACViaOffsetY);

//  			addCommand("lock " + moc3063Name);
//  			addCommand("lock " + ledResistor.name);
//  			addCommand("lock " + triac.name);
//  			addCommand("lock " + gateResistor.name);
		}
	}
}

