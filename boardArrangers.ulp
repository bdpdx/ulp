}

void arrangePumpControl(string opto, real ox, real oy, string q, string rA, string rB, int vertical) {
	move(opto, ox, oy);

	if (vertical) {
		rotate(opto, 90);
		rotate(rA, 270);
		move(rA, ox + 1, oy - 5.5);

		move(rB, ox - 1, oy - 5);
	
		rotate(q, 270);
		move(q, ox - 0.6, oy - 7.5);
	
		addVia("GND", ox - 0.5, oy - 8.5);
	} else {
		rotate(rA, 180);
		move(rA, ox - 5.5, oy - 1);

		rotate(rB, 270);
		move(rB, ox - 5, oy + 1);
	
		rotate(q, 180);
		move(q, ox - 7.5, oy + 0.6);
	
		addVia("GND", ox - 8.5, oy + 0.5);
	}
}

