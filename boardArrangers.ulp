void arrangeLevelShifter(string q, real qx, real qy, string r33v, string r5v) {
	move(q, qx, qy);
// 	swap0402Label(r33v);
	rotate(r33v, 90);
	move(r33v, qx - 2.5, qy);
	addVia("3.3V", qx - 2.5, qy + 1.5);
	rotate(r5v, 270);
	move(r5v, qx + 2.5, qy);
	addVia("3.3V", qx - 1, qy + 0.25);
}

