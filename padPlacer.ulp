void createPadsForSMC_KBP310G() {
	// bridge rectifier
	// copy this to the global padNumbers variable
// 	int padNumbers[] = {
// 		1, 2, 3, 4
// 	};

	distanceBetweenPadCentersHorizontally = (4.06 + 3.56) / 2.0;	// 3.81
	distanceBetweenPadCentersVertically = 1;
	numberOfPadColumns = 4;
	numberOfPadRows = 1;
	padDrillDiameter = 1.5;	

// 	real spaceBetweenPins = distanceBetweenPadCentersHorizontally - padDrillDiameter - minimumPadToPadClearance;
// 	spaceBetweenPins /= 2;	// allocate half the distance for each pin	// 1.0915
	padDiameter = 2.54;	// could go ~3.5, but this is the same as the CUI Devices pad size so go with it.

	setup();

	real partWidth = distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1) + padDiameter;
	real partHeight = distanceBetweenPadCentersVertically * (numberOfPadRows - 1) + padDiameter;

	printf("partWidth %f, height %f\n", partWidth, partHeight);

	// 1: Place Pads
	placePads(partHeight, partWidth);
	
	// 2: Define keepout region

	addCommand("layer tKeepout");

	// from datasheet, package is 1"x1"	
	partHeight = 3.65;
	partWidth = 14.75;

	real upperLeftX = -partWidth / 2;
	real upperLeftY = partHeight / 2;
	real lowerRightX = -upperLeftX;
	real lowerRightY = -upperLeftY;
		
	drawRectangle(upperLeftX, upperLeftY, lowerRightX, lowerRightY, 0);

	// Draw package outline

	addCommand("layer tPlace");

	drawRectangle(upperLeftX, upperLeftY, lowerRightX, lowerRightY, 0.2);
	
	real y = floor(-partHeight / 2) - 0.1;

	addCommand("layer tNames");
	addCommand("change align top-left");
	
	sprintf(cmd, "text '>NAME' (%0.03f %0.03f)", upperLeftX, y);
	addCommand(cmd);

	addCommand("layer tValues");
	addCommand("change align top-right");
	
	sprintf(cmd, "text '>VALUE' (%0.03f %0.03f)", lowerRightX, y);
	addCommand(cmd);
}

void createSMDsFor0402() {
	int padNumbers[] = {
		1, 2
	};

	real smdHeight = 0.7;
	real smdWidth = 0.6;
	distanceBetweenPadCentersHorizontally = 0.5 + smdWidth;
	numberOfPadColumns = 2;
	numberOfPadRows = 1;
	
	setup();
	
	real partWidth = distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1) + smdWidth;
	real partHeight = distanceBetweenPadCentersVertically * (numberOfPadRows - 1) + smdHeight;

	printf("partWidth %f, height %f\n", partWidth, partHeight);

	// 1: Place Pads
	placeSMDsCenteredAboutOrigin(partHeight, partWidth, smdHeight, smdWidth);
	
	// 2: Define keepout region

	addCommand("layer tKeepout");

	real keepoutOverhang = 0.2;

	real top = partHeight / 2 + keepoutOverhang;
	real left = -partWidth / 2 - keepoutOverhang;
	real bottom = -top;
	real right = -left	;
		
	drawRectangle(left, top, right, bottom, 0);

	// Draw package outline

	addCommand("layer tPlace");

	drawRectangle(left, top, right, bottom, minimumLineWidth);

	addCommand("layer tNames");
	addCommand("change align bottom-center");
	
	real x = 0;
	real y = ceilingTo(top, 0.5);
	
	sprintf(cmd, "text '>NAME' %s", point(x, y));
	addCommand(cmd);

	addCommand("layer tValues");
	addCommand("change align top-center");
	
	sprintf(cmd, "text '>VALUE' %s", point(x, -y));
	addCommand(cmd);
}

void createSMDsFor0402Polarized() {
	int padNumbers[] = {
		1, 2
	};

	real smdHeight = 0.7;
	real smdWidth = 0.6;
	distanceBetweenPadCentersHorizontally = 0.5 + smdWidth;
	numberOfPadColumns = 2;
	numberOfPadRows = 1;
	
	setup();
	
	real partWidth = distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1) + smdWidth;
	real partHeight = distanceBetweenPadCentersVertically * (numberOfPadRows - 1) + smdHeight;

	printf("partWidth %f, height %f\n", partWidth, partHeight);

	// 1: Place Pads
	placeSMDsCenteredAboutOrigin(partHeight, partWidth, smdHeight, smdWidth);
	
	// 2: Define keepout region

	addCommand("layer tKeepout");

	real keepoutOverhang = 0.2;

	real top = partHeight / 2 + keepoutOverhang;
	real left = -partWidth / 2 - keepoutOverhang;
	real bottom = -top;
	real right = -left	;
		
	drawRectangle(left, top, right, bottom, 0);

	// Draw package outline

	addCommand("layer tPlace");

	real inset = 0.1;
	real minusLength = 0.2;
	
	drawLine(minimumLineWidth, left, top, right, top);
	drawLine(minimumLineWidth, right, top, right, top - inset);
	drawLine(minimumLineWidth, right, bottom + inset, right, bottom);
	drawLine(minimumLineWidth, right, bottom, left, bottom);
	drawLine(minimumLineWidth, left, bottom, left, bottom + inset);
	drawLine(minimumLineWidth, left, top - inset, left, top);
	drawLine(minimumLineWidth, right, minusLength / 2, right, -minusLength / 2);
	drawLine(minimumLineWidth, left, -minusLength / 2, left, minusLength / 2);
	drawLine(minimumLineWidth, left - minusLength / 2, 0, left + minusLength / 2, 0);

	addCommand("layer tNames");
	addCommand("change align bottom-center");
	
	real x = 0;
	real y = ceilingTo(top, 0.5);
	
	sprintf(cmd, "text '>NAME' %s", point(x, y));
	addCommand(cmd);

	addCommand("layer tValues");
	addCommand("change align top-center");
	
	sprintf(cmd, "text '>VALUE' %s", point(x, -y));
	addCommand(cmd);
}

