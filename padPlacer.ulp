#usage "Brian's Pad Placer"

#include "common.ulp"

// all units in this file in mm

real gridMajorDivision = 0.5;
real gridMinorDivision = 0.01;
string gridUnit = "mm";

real distanceBetweenPadCentersHorizontally = 2.54 * 2;
real distanceBetweenPadCentersVertically = 2.54 * 2;
int numberOfPadColumns = 1;
int numberOfPadRows = 1;
real padDiameter = 0;
real padDrillDiameter = 0.6;

// ULPs support neither multidimensional arrays nor passing/returning arrays so use a
// global single-dimensional array for padNumbers. Zero values mean don't place that
// pad.
int padNumbers[] = {
	1, 6,
	2, 5,
	3, 4
};

void setup() {
	setGrid(1, gridUnit, gridMajorDivision, gridMinorDivision);

	addCommand("change font vector");
	addCommand("change ratio 8");

	sprintf(cmd, "change size %0.03f", minimumTextHeight);
	addCommand(cmd);

	sprintf(cmd, "change width %0.03f", minimumLineWidth);
	addCommand(cmd);
}

void placeShapedPads(real partHeight, real partWidth, string firstPadShape, string otherPadsShape) {
	sprintf(cmd, "change diameter %0.03f", padDiameter);
	addCommand(cmd);

	sprintf(cmd, "change drill %0.03f", padDrillDiameter);
	addCommand(cmd);

	int hasPlacedFirstPad = 0;

	sprintf(cmd, "change shape %s", firstPadShape);
	addCommand(cmd);

	real y = (partHeight - padDiameter) / 2;

	// place columns left to right
	// place rows top to bottom
	for (int i = 0; i < numberOfPadRows; ++i) {
		int index = i * numberOfPadColumns;

		real x = (-partWidth + padDiameter) / 2;
	
		for (int j = 0; j < numberOfPadColumns; ++index, ++j) {
			printf("column %d, x is %0.03f, y is %0.03f\n", i, x, y);

			int padNumber = padNumbers[index];
			
			if (padNumber >= 1) {
				sprintf(cmd, "pad (%0.03f %0.03f)", x, y);
				addCommand(cmd);
				
				if (!hasPlacedFirstPad) {
					hasPlacedFirstPad = 1;
					
					sprintf(cmd, "change shape %s", otherPadsShape);
					addCommand(cmd);
				}
			}
			
			x += distanceBetweenPadCentersHorizontally;
		}
		
		y -= distanceBetweenPadCentersVertically;
	}
}

void placePads(real partHeight, real partWidth) {
	placeShapedPads(partHeight, partWidth, "round", "round");
}

void placeSMDs(real partHeight, real partWidth, real smdHeight, real smdWidth, real centerX, real centerY) {
	addCommand("layer top");

	real y = centerY + (partHeight - smdHeight) / 2;

	// place columns left to right
	// place rows top to bottom
	for (int row = 0; row < numberOfPadRows; ++row) {
		int index = row * numberOfPadColumns;

		real x = centerX + (-partWidth + smdWidth) / 2;
	
		for (int column = 0; column < numberOfPadColumns; ++index, ++column) {
			printf("row %d : column %d, x is %0.03f, y is %0.03f\n", row, column, x, y);

			int padNumber = padNumbers[index];
			
			if (padNumber >= 1) {
				sprintf(cmd, "smd %0.3f %0.3f 'p$%d' %s", smdWidth, smdHeight, padNumber, point(x, y));
				addCommand(cmd);
			}
			
			x += distanceBetweenPadCentersHorizontally;
		}
		
		y -= distanceBetweenPadCentersVertically;
	}
}

void placeSMDsCenteredAboutOrigin(real partHeight, real partWidth, real smdHeight, real smdWidth) {
	placeSMDs(partHeight, partWidth, smdHeight, smdWidth, 0.0, 0.0);
}

void createPadsForAishiCapacitor(real partDiameter, real leadCenterToCenter, real leadDiameter) {
	// aluminum electrolytic capacitor
	// copy this to the global padNumbers variable
// 	int padNumbers[] = {
// 		1, 2
// 	};

	real partRadius = partDiameter / 2;

	distanceBetweenPadCentersHorizontally = leadCenterToCenter;
	distanceBetweenPadCentersVertically = 0;
	numberOfPadColumns = 2;
	numberOfPadRows = 1;
	padDiameter = 1.5;
	padDrillDiameter = leadDiameter;

	setup();

	real partWidth = distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1) + padDiameter;
	real partHeight = distanceBetweenPadCentersVertically * (numberOfPadRows - 1) + padDiameter;

	printf("partWidth %f, height %f\n", partWidth, partHeight);

	// 1: Place Pads
	placeShapedPads(partHeight, partWidth, "square", "round");
	
	// 2: Define keepout region

	addCommand("layer tKeepout");
	
	drawCircle(0, 0, 0, partRadius + minimumLineWidth / 2);

	// Draw package outline

	addCommand("layer tPlace");

	drawCircle(minimumLineWidth, 0, 0, partRadius);

	addCommand("change align bottom-center");
	
	real x = -distanceBetweenPadCentersHorizontally / 2;
	real y = floorTo(padDiameter / 2 + 0.5, 0.5);
	
	sprintf(cmd, "text '+' %s", point(x, y));
	addCommand(cmd);
	sprintf(cmd, "text '-' %s", point(-x, y));
	addCommand(cmd);

	x = 0;
	y = partRadius + 0.2;
	
	addCommand("layer tNames");
	addCommand("change align bottom-center");
	
	sprintf(cmd, "text '>NAME' (%0.03f %0.03f)", x, y);
	addCommand(cmd);

	addCommand("layer tValues");
	addCommand("change align top-center");

	sprintf(cmd, "text '>VALUE' (%0.03f %0.03f)", x, -y);
	addCommand(cmd);
}

void createPadsForCUIDevices_PDQE30_D() {
	// dc-dc converter
	// copy this to the global padNumbers variable
// 	int padNumbers[] = {
// 		1, 6,
// 		0, 0,
// 		0, 0,
// 		2, 0,
// 		0, 5,
// 		3, 0,
// 		0, 0,
// 		0, 0,
// 		0, 4
// 	};

	distanceBetweenPadCentersHorizontally = 20.32;
	distanceBetweenPadCentersVertically = 2.54;
	gridMajorDivision = 2.54;
	numberOfPadColumns = 2;
	numberOfPadRows = 9;
	padDiameter = 2.54;
	padDrillDiameter = 1.42;

	setup();

	real partWidth = distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1) + padDiameter;
	real partHeight = distanceBetweenPadCentersVertically * (numberOfPadRows - 1) + padDiameter;

	printf("partWidth %f, height %f\n", partWidth, partHeight);

	// 1: Place Pads
	placePads(partHeight, partWidth);
	
	// 2: Define keepout region

	addCommand("layer tKeepout");

	// from datasheet, package is 1"x1"	
	partHeight = 25.4;
	partWidth = 25.4;

	real cornerRadius = gridMajorDivision / 2;
	real upperLeftX = -partWidth / 2;
	real upperLeftY = partHeight / 2;
	real lowerRightX = -upperLeftX;
	real lowerRightY = -upperLeftY;
		
	drawRoundedRectangle(upperLeftX, upperLeftY, lowerRightX, lowerRightY, cornerRadius, 0);

	// Draw package outline

	addCommand("layer tPlace");

	drawRoundedRectangle(upperLeftX, upperLeftY, lowerRightX, lowerRightY, cornerRadius, 0.25);
	
	real x = upperLeftX + cornerRadius;
	real y = partHeight / 2 + 0.5;

	addCommand("layer tNames");
	addCommand("change align bottom-left");
	
	sprintf(cmd, "text '>NAME' (%0.03f %0.03f)", x, y);
	addCommand(cmd);

	addCommand("layer tValues");
	addCommand("change align top-left");
	
	sprintf(cmd, "text '>VALUE' (%0.03f %0.03f)", x, -y);
	addCommand(cmd);
}

void createPadsForHRO_K3_1204D() {
	// SPDT slide switch red
	
	// copy this to the global padNumbers variable
// 	int padNumbers[] = {
//		1, 2, 3
// 	};

	distanceBetweenPadCentersHorizontally = 2.55;
	distanceBetweenPadCentersVertically = 0;
	numberOfPadColumns = 3;
	numberOfPadRows = 1;
	padDiameter = distanceBetweenPadCentersHorizontally - 0.4;
	padDrillDiameter = 0.9;

	setup();

	real partWidth = distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1) + padDiameter;
	real partHeight = distanceBetweenPadCentersVertically * (numberOfPadRows - 1) + padDiameter;

	printf("partWidth %f, height %f\n", partWidth, partHeight);

	// 1: Place Pads
	placePads(partHeight, partWidth);
	
	// 2: Define keepout region

	addCommand("layer tKeepout");

	partHeight = 2.5;
	partWidth = 10.0;

	real upperLeftX = -partWidth / 2;
	real upperLeftY = partHeight / 2;
	real lowerRightX = -upperLeftX;
	real lowerRightY = -upperLeftY;
		
	drawRectangle(upperLeftX, upperLeftY, lowerRightX, lowerRightY, 0);

	// Draw package outline

	addCommand("layer tPlace");

	drawRectangle(upperLeftX, upperLeftY, lowerRightX, lowerRightY, minimumLineWidth);
	
	real x = upperLeftX;
	real y = partHeight / 2 + 0.25;

	addCommand("layer tNames");
	addCommand("change align bottom-left");
	
	sprintf(cmd, "text '>NAME' (%0.03f %0.03f)", x, y);
	addCommand(cmd);

	addCommand("layer tValues");
	addCommand("change align top-left");
	
	sprintf(cmd, "text '>VALUE' (%0.03f %0.03f)", x, -y);
	addCommand(cmd);
}

void createPadsForJSTXH() {
	// JST XH board-to-wire header connector
	// copy this to the global padNumbers variable
// 	int padNumbers[] = {
// 		1, 2, 3
// 	};

	distanceBetweenPadCentersHorizontally = 2.5;
	distanceBetweenPadCentersVertically = 0;
	numberOfPadColumns = 4;
	numberOfPadRows = 1;
	padDiameter = distanceBetweenPadCentersHorizontally - 0.4;
	padDrillDiameter = 0.9;

	setup();

	real partWidth = distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1) + padDiameter;
	real partHeight = distanceBetweenPadCentersVertically * (numberOfPadRows - 1) + padDiameter;

	printf("partWidth %f, height %f\n", partWidth, partHeight);

	// 1: Place Pads
	placePads(partHeight, partWidth);
	
	// 2: Define keepout region

	addCommand("layer tKeepout");

	real notchInset = 2.45;
	partHeight = 5.75;
	partWidth = notchInset * 2 + distanceBetweenPadCentersHorizontally * (numberOfPadColumns - 1);

	real left = -partWidth / 2;
	real right = -left;
	real top = partHeight / 2;
	real bottom = -top;
		
	drawRectangle(left, top, right, bottom, 0);

	// Draw package outline

	addCommand("layer tPlace");

	real notchHeight = 0.75;
	real notchWidth = 2;
	real notchStart = notchInset - notchWidth / 2;

	drawLine(minimumLineWidth, left, top, right, top);
	drawLine(minimumLineWidth, right, top, right, bottom);
	drawLine(minimumLineWidth, right, bottom, right - notchStart, bottom);
	drawLine(minimumLineWidth, right - notchStart, bottom, right - notchStart, bottom + notchHeight);
	drawLine(minimumLineWidth, right - notchStart, bottom + notchHeight, right - notchStart - notchWidth, bottom + notchHeight);
	drawLine(minimumLineWidth, right - notchStart - notchWidth, bottom + notchHeight, right - notchStart - notchWidth, bottom);
	drawLine(minimumLineWidth, right - notchStart - notchWidth, bottom, left + notchStart + notchWidth, bottom);
	drawLine(minimumLineWidth, left + notchStart + notchWidth, bottom, left + notchStart + notchWidth, bottom + notchHeight);
	drawLine(minimumLineWidth, left + notchStart + notchWidth, bottom + notchHeight, left + notchStart, bottom + notchHeight);
	drawLine(minimumLineWidth, left + notchStart, bottom + notchHeight, left + notchStart, bottom);
	drawLine(minimumLineWidth, left + notchStart, bottom, left, bottom);
	drawLine(minimumLineWidth, left, bottom, left, top);
	
	real x = left;
	real y = partHeight / 2 + 0.25;

	addCommand("layer tNames");
	addCommand("change align bottom-left");
	
	sprintf(cmd, "text '>NAME' (%0.03f %0.03f)", x, y);
	addCommand(cmd);

	addCommand("layer tValues");
	addCommand("change align top-left");
	
	sprintf(cmd, "text '>VALUE' (%0.03f %0.03f)", x, -y);
	addCommand(cmd);
}

