#usage "Fertigator V2 Placer ULP"

// Stackup for this project:
// Layer 1, Top, 5V
// Layer 2, Route 2, GND
// Layer 3, Route 3, 24VAC+
// Layer 14, Route 14, 24VAC-
// Layer 15, Route 15, GND
// Layer 16, Bottom, 3.3V

#include "boardArrangers.ulp"

/*

rip @	-- removes just polyons

*/

real esp32NotchHeight = 6;
real esp32NotchWidth = 22;

int scriptPhase = 1;

void startPhase1() {
// 	renumberPartsInSchematic(0);
}

void startPhase2() {
// 	renumberPartsInSchematic(1);
}

void startPhase3() {
	if (!board) addCommand("board");

	addCommand("grid lines on mm 0.5 1 alt 0.01 mm");

	showLayer(LAYER_DIMENSION);
	showLayer(LAYER_TNAMES);
	showLayer(LAYER_TVALUES);
	
	selectLayer(LAYER_TOP);
}

void startPhase4() {
	addCommand("lock -*");
	addCommand("ripup");	// delete all traces and vias
	addCommand("ratsnest ! *");

	// move all parts into off-board grid
	string parts = allBoardElementNamesSeparatedByNewline();
	movePartsToGrid(parts, 20, boardWidth + 45, boardHeight, 25, -25);
	repositionParts(parts);
	rotateParts(parts, 0);
}

void startPhase5() {
	// set all name and value labels to minimumTextHeight and rotate components as needed
	project.board(b) {
		b.elements(e) {
			e.texts(t) {
				if (!(t.layer == LAYER_TNAMES || t.layer == LAYER_TVALUES)) continue;
				
				sprintf(cmd, "change size %0.03f %s", minimumTextHeight, point(u2mm(t.x), u2mm(t.y)));
				addCommand(cmd);
			}
		}
	}
}

void startPhase6() {
	// hide values for various small parts
	project.board(b) {
		b.elements(e) {
			string decodedName = decodeNameIntoPartPrefixAndIndexSuffix(e.name);
			string nameParts[];
			int partNumber = 0;
			
			if (strsplit(nameParts, decodedName, ',') == 2) {
				partNumber = strtol(nameParts[1]);
			}
			
			string prefix = nameParts[0];
			
			printf("e.name is %s, prefix is %s\n", e.name, prefix);
			
			int shouldHideValue = 0;
			
			if (!strcmp(prefix, "C")) shouldHideValue = 1;
			else if (!strcmp(prefix, "D")) shouldHideValue = 1;
			else if (!strcmp(prefix, "FB")) shouldHideValue = 1;
			else if (!strcmp(prefix, "J")) {
				if (partNumber == 2) shouldHideValue = 1;
			}
			else if (!strcmp(prefix, "LED")) shouldHideValue = 1;
			else if (!strcmp(prefix, "Q")) shouldHideValue = 1;
			else if (!strcmp(prefix, "R")) shouldHideValue = 1;
			else if (!strcmp(prefix, "T")) shouldHideValue = 1;
			else if (!strcmp(prefix, "U")) {
				// MOC 3063 U11-U42
				if (partNumber == 3) shouldHideValue = 1;
				else if (partNumber == 5) shouldHideValue = 1;
				else if (partNumber >= 6 && partNumber <= 10) shouldHideValue = 1;
				else if (partNumber >= 11 && partNumber <= 42) shouldHideValue = 1;
				else if (partNumber == 46) shouldHideValue = 1;
			}
			else if (!strcmp(prefix, "X")) shouldHideValue = 1;

			if (!shouldHideValue) continue;
		
			e.texts(t) {
				if (t.layer != LAYER_TVALUES) continue;

				// "reposition 'name'" will restore the label visibility
				sprintf(cmd, "change display off %s", u2mmPoint(t.x, t.y));
				addCommand(cmd);
			}
		}
	}
}

void startPhase7() {
	real x = boardWidth / 2;
	
	// arrange terminal blocks
	real halfTerminalBlockHeight = cuiDevicesTerminalBlockHeight / 2;
	real terminalBlockWidth = cuiDevicesTerminalBlockWidth(27);
	real lowerBlockY = minimumBoardEdgeMargin + halfTerminalBlockHeight;

	move("J10", x, lowerBlockY);		// J9 is terminal block 1

	real upperBlockY = lowerBlockY + ceilingTo(halfTerminalBlockHeight + 25.4, 0.5);

	move("J9", x, upperBlockY);	// J10 is terminal block 2

	// H1-4 are mounting holes
	real y = ((upperBlockY - halfTerminalBlockHeight) + (lowerBlockY + halfTerminalBlockHeight)) / 2;

	move("H1", mountingHoleInset, y);
	move("H2", boardWidth - mountingHoleInset, y);
	move("H3", boardWidth -	 esp32NotchWidth - mountingHoleInset - 14, boardHeight - mountingHoleInset);
	move("H4", mountingHoleInset, boardHeight - mountingHoleInset);
}

void startPhase8() {
	int numberOfSolenoids = 32;
	int numberOfTerminals = 26;

	// arrange indicator resistors
// 	UL_ELEMENT lowerBlock = findBoardPartNamed("J10");
//
// 	real lowerBlockOriginX = u2mm(lowerBlock.x);
// 	real lowerBlockBottomLeftX = lowerBlockOriginX - cuiDevicesTerminalBlockWidth(numberOfTerminals) / 2;
// 	real lowerBlockOriginY = u2mm(lowerBlock.y);
// 	real lowerBlockBottomLeftY = lowerBlockOriginY - halfTerminalBlockHeight;

	// upper terminal block J9 contains ports for solenoids 1-26
	UL_ELEMENT upperBlock = findBoardPartNamed("J9");

	real halfTerminalBlockHeight = cuiDevicesTerminalBlockHeight / 2;
	
	// terminal block part origin is in the center of the part
	real upperBlockOriginX = u2mm(upperBlock.x);
	real upperBlockBottomLeftX = upperBlockOriginX - cuiDevicesTerminalBlockWidth(numberOfTerminals) / 2;
	real upperBlockOriginY = u2mm(upperBlock.y);
	real upperBlockBottomLeftY = upperBlockOriginY - halfTerminalBlockHeight;
		
	real x = upperBlockBottomLeftX + cuiDevicesTerminalBlockPin1OffsetX;
	real y = upperBlockBottomLeftY + cuiDevicesTerminalBlockHeight + 6.5;
   
	int i;
	int j;
	int solenoidLED = 6;
	int solenoidLEDResistor = 34;

	string solenoidLEDNames = "";
	string solenoidResistorNames = "";

	// terminal block 1, solenoids 1-26
	for (i = 0, j = 0; i < numberOfSolenoids;) {
		string led, resistor;

		sprintf(led, "LED%d", solenoidLED + j);
		sprintf(resistor, "R%d", solenoidLEDResistor + j);

		solenoidLEDNames += led + ",";
		solenoidResistorNames += resistor + ",";

		UL_ELEMENT e = findBoardPartNamed(led);

		swap0402Label(led);
		move(led, x, y);
		rotate(led, 270);
		move(resistor, x + 1.5, y);
		rotate(resistor, 270);

		// add gnd via for resistor
		addVia("GND", x + 1.5, y + 2);

		x += cuiDevicesTerminalBlockHorizontalDistanceBetweenPins;

		if (++i == numberOfTerminals) {
			x = upperBlockBottomLeftX + cuiDevicesTerminalBlockPin1OffsetX;
			y -= 4;
		}
		if (++j % 4 == 0) {
			j = 0;
			solenoidLED += 4;
			solenoidLEDResistor += 12;
		}
	}

	string pumpLEDNames = "";
	string pumpResistorNames = "";
	
	int numberOfPumps = 8;
	int pumpLED = 38;
	int pumpLEDResistor = 130;

	for (i = 0, j = 0; i < numberOfPumps; ++i) {
		string led, resistor;
		
		sprintf(led, "LED%d", pumpLED + j);
		sprintf(resistor, "R%d", pumpLEDResistor + j);

		pumpLEDNames += led + ",";
		pumpResistorNames += resistor + ",";

		swap0402Label(led);
		move(led, x, y);
		rotate(led, 270);
		move(resistor, x + 1.5, y);
		rotate(resistor, 270);

		// add gnd via for resistor
		addVia("GND", x + 1.5, y + 2);

		x += 2 * cuiDevicesTerminalBlockHorizontalDistanceBetweenPins;
		
		if (++j % 4 == 0) {
			j = 0;
			pumpLED += 4;
			pumpLEDResistor += 12;
		}
	}
	
//  If led or resistor part numbers change, print these into the log file to setup
//  variables in phases 9 and 10
// 	printf(solenoidLEDNames + "\n");
// 	printf(solenoidResistorNames + "\n");
// 	printf(pumpLEDNames + "\n");
// 	printf(pumpResistorNames + "\n");
}

