void startPhase19() {
	// draw power plane polygons
	real halfMinimumLineWidth = minimumLineWidth / 2;
	real left = -halfMinimumLineWidth;
	real right = boardWidth + halfMinimumLineWidth;
	real bottom = -halfMinimumLineWidth;
	real top = boardHeight + halfMinimumLineWidth;
	string drawPolygon;
	string polygonFormat;
	
	sprintf(drawPolygon, "polygon %0.03f %s %s %s %s %s",
		minimumLineWidth,
		point(left, bottom),
		point(right, bottom),
		point(right, top),
		point(left, top),
		point(left, bottom)
	);
	sprintf(polygonFormat, "polygon '%%s' %0.03f %s %s %s %s %s",
		minimumLineWidth,
		point(left, bottom),
		point(right, bottom),
		point(right, top),
		point(left, top),
		point(left, bottom)
	);
	
	// should be drawing these polygons with 0.012" (0.305mm) isolate
	// + setting nets
	// Stackup for this project:
	// Layer 1, Top, 5V
	// Layer 2, Route 2, GND
	// Layer 3, Route 3, 24VAC+
	// Layer 14, Route 14, 24VAC-
	// Layer 15, Route 15, GND
	// Layer 16, Bottom, 3.3V

	// 2-layer board polygons
	addCommand("layer 1");
	addCommand(drawPolygon);
	addCommand("layer 16");
	addCommand(drawPolygon);

	// 4-layer board polygons
	addCommand("layer Route2");
	addCommand(drawPolygon);

	addCommand("layer Route15");
	addCommand(drawPolygon);
// 	sprintf(cmd, polygonFormat, "");
// 	addCommand(cmd);

	// 6-layer board polygons
// 	addCommand("layer Route3");
// 	addCommand(drawPolygon);
// 	addCommand("layer Route14");
// 	addCommand(drawPolygon);
}

int shouldSkipPhase(int phaseNumber) {
	int result = 0;

	switch (phaseNumber) {
// 		case 1:		result = 1;		break;
// 		case 2:		result = 1;		break;
// 		case 3:		result = 1;		break;
// 		case 4:		result = 1;		break;
// 		case 5:		result = 1;		break;
// 		case 6:		result = 1;		break;
// 		case 7:		result = 1;		break;
		default:					break;
	}
	
	return result;
}

int main() {
	// this script assumes board has been dimensioned to 164x198

	int stopPhase = INT_MAX;
	string strings[];
	int n = strsplit(strings, argv[0], '/');
	string scriptName = strings[n - 1];

	// script phases are necessary because the script is read-only.
	// run a phase, execute its commands, then re-run the script in
	// the next phase to observe changes.

	// b.ulp startPhase stopPhase

	if (argc > 1) scriptPhase = strtol(argv[1]);
	if (argc > 2) stopPhase = strtol(argv[2]);
	
	sprintf(cmd, "starting %s in phase %d", scriptName, scriptPhase);
	status(cmd);
	
	output("/tmp/ulp.log", scriptPhase == 1 ? "wt" : "at") {
		printf("*** start phase %d\n", scriptPhase);

		project.board(b) getBoardInfo(b, scriptPhase == 1);

		addCommand("set beep off");
		addCommand("set confirm yes");

		int totalNumberOfScriptPhases = 19;
		int numberOfScriptPhases = min(totalNumberOfScriptPhases, stopPhase);

		if (!shouldSkipPhase(scriptPhase)) {
			switch (scriptPhase) {
				case 1:		startPhase1();		break;
				case 2:		startPhase2();		break;
				case 3:		startPhase3();		break;
				case 4:		startPhase4();		break;
				case 5:		startPhase5();		break;
				case 6:		startPhase6();		break;
				case 7:		startPhase7();		break;
				case 8:		startPhase8();		break;
				case 9:		startPhase9();		break;
				case 10:	startPhase10();		break;
				case 11:	startPhase11();		break;
				case 12:	startPhase12();		break;
				case 13:	startPhase13();		break;
				case 14:	startPhase14();		break;
				case 15:	startPhase15();		break;
				case 16:	startPhase16();		break;
				case 17:	startPhase17();		break;
				case 18:	startPhase18();		break;
 				case 19:	startPhase19();		break;
			}
		}

		if (++scriptPhase <= numberOfScriptPhases) {
			sprintf(cmd, "run %s %d %d", scriptName, scriptPhase, stopPhase);
			addCommand(cmd);
		} else {
			sprintf(cmd, "script %s finished", scriptName);
			status(cmd);
		}
		
		Exit();
	}

	return 0;
}
