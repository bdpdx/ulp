int boardLayerNameToNumber(string layerName) {
	int n = -1;

	board(b) {
		b.layers(l) {
			if (!strcmp(l.name, layerName)) {
				n = l.number;
				break;
			}
		}
	}
	
	if (n == -1) {
		printf("layer '" + layerName + "' not found\n");
	}

	return n;
}

void printDimension(UL_DIMENSION d, string prefix) {
	printf("%s%s %s %s\n", prefix, u2mmPoint(d.x1, d.y1), u2mmPoint(d.x2, d.y2), u2mmPoint(d.x3, d.y3));
}

void printWire(UL_WIRE w, string prefix) {
	printf("%swire from %s to %s on layer %s\n", prefix, u2mmPoint(w.x1, w.y1), u2mmPoint(w.x2, w.y2), layerToString(w.layer));
}

void printSchematicInfo(UL_SCHEMATIC sch) {
	string alwaysVectorFontAttributes = "";

	if (sch.alwaysvectorfont & ALWAYS_VECTOR_FONT_GUI) {
		alwaysVectorFontAttributes += "ALWAYS_VECTOR_FONT_GUI";
	}
	if (sch.alwaysvectorfont & ALWAYS_VECTOR_FONT_PERSISTENT) {
		if (strlen(alwaysVectorFontAttributes) > 0) {
			alwaysVectorFontAttributes += ", ";
		}
		alwaysVectorFontAttributes += "ALWAYS_VECTOR_FONT_PERSISTENT";
	}
		
	printf("schematic info\n");
	printf("  alwaysvectorfont: " + alwaysVectorFontAttributes + "\n");
	printf("  checked: %d\n", sch.checked);
	printf("  description: " + sch.description + "\n");
	printf("  headline: " + sch.headline + "\n");
	printf("  name: " + sch.name + "\n\n");
}

void repositionParts(string partNamesSeparatedByNewline) {
	int partCount;
	string partNames[];

	if ((partCount = strsplit(partNames, partNamesSeparatedByNewline, '\n')) < 1) return;

	for (int i = 0; i < partCount; ++i) {
		sprintf(cmd, "reposition %s", partNames[i]);
		addCommand(cmd);
	}
}

void rotate(string partName, real rotation) {
	sprintf(cmd, "rotate =R%0.01f '%s'", rotation, partName);
	addCommand(cmd);
}

void rotateParts(string partNamesSeparatedByNewline, real rotation) {
	int partCount;
	string partNames[];

	if ((partCount = strsplit(partNames, partNamesSeparatedByNewline, '\n')) < 1) return;

	for (int i = 0; i < partCount; ++i) {
		rotate(partNames[i], rotation);
	}
}

void selectLayer(int layerNumber) {
	sprintf(cmd, "layer %d", layerNumber);
	addCommand(cmd);
}

void setLayerVisible(int layerNumber, int isVisible) {
	sprintf(cmd, "display %s%d", isVisible ? "" : "-", layerNumber);
	addCommand(cmd);
}

void hideLayer(int layerNumber) {
	setLayerVisible(layerNumber, 0);
}

void showLayer(int layerNumber) {
	setLayerVisible(layerNumber, 1);
}

void showSheet(int sheetNumber) {
	sprintf(cmd, "edit .s%d", sheetNumber);
	addCommand(cmd);
}

UL_ELEMENT findBoardPartNamed(string name) {
	UL_ELEMENT part;

	if (project.board) {	
		project.board(b) {
			b.elements(e) {
				if (!strcmp(e.name, name)) return e;
			}
		}
	}
	
	return part;
}

UL_PART findSchematicPartNamed(string name) {
	UL_PART part;
	
	if (project.schematic) {
		project.schematic(s) {
			s.allparts(p) {
				if (!strcmp(p.name, name)) return p;
			}
		}
	}	
	
	return part;
}

UL_TEXT findNameLabelForPartNamed(string name) {
	UL_ELEMENT e = findBoardPartNamed(name);
	
	e.texts(t) {
		if (t.layer == LAYER_TNAMES) return t;
	}
}

UL_TEXT findValueLabelForPartNamed(string name) {
	UL_ELEMENT e = findBoardPartNamed(name);

	e.texts(t) {
		if (t.layer == LAYER_TVALUES) return t;
	}
}

void movePartsToGrid(string partNamesSeparatedByNewline, int columns, real startX, real startY, real xOffset, real yOffset) {
	int partCount;
	string partNames[];

	if ((partCount = strsplit(partNames, partNamesSeparatedByNewline, '\n')) < 1) return;

	printf("moving %d parts into grid\n", partCount);	

	for (int i = 0; i < partCount; ++i) {
		string partName = partNames[i];
		UL_ELEMENT e = findBoardPartNamed(partName);

		real newX = startX + xOffset * (i % columns);
		real newY = startY + yOffset * (i / columns);
		real oldX = u2mm(e.x);
		real oldY = u2mm(e.y);
		
		if (oldX == newX && oldY == newY) continue;

		sprintf(cmd, "move %s %s", partName, point(newX, newY));
		addCommand(cmd);
	}
}

string decodeNameIntoPartPrefixAndIndexSuffix(string name) {
	int length;
	int n = strxstr(name, "^[^0-9]+", 0, length);
	
	string partPrefix = strsub(name, n, length);
	string indexSuffix = strsub(name, n + length);
	
	return partPrefix + "," + indexSuffix;
}

string partPrefix(string name) {
	int length;
	int n = strxstr(name, "^[^0-9]+", 0, length);
	
	return strsub(name, n, length);
}

void setGrid(int showLines, string unit, real majorDivision, real minorDivision) {
	sprintf(cmd, "grid lines %s %s %0.02f 1 alt %0.02f %s", showLines ? "on" : "off", unit, majorDivision, minorDivision, unit);
	addCommand(cmd);
}

void Exit() {
	string strings[];

	if (strlen(exitCommands) > 0) {
		printf("exitCommands:\n");

		int n = strsplit(strings, exitCommands, ';');

		for (int i = 0; i < n; ++i) {
			if (strlen(strings[i]) < 1) continue;
			printf("%s\n", strings[i]);
		}
	}
	
	exit(exitCommands);
}

void deleteLayerContents(int layerNumber) {
	sprintf(cmd, "display none %d", layerNumber);
	addCommand(cmd);
	addCommand("group all");
	addCommand("delete (>0 0)");
	addCommand("display last");
}

void deleteBoardLayer(string layerName) {
	int layerNumber = boardLayerNameToNumber(layerName);

	if (layerNumber == -1) {
		printf("layer '" + layerName + "' not found\n");
		return;
	}

	deleteLayerContents(layerNumber);

	sprintf(cmd, "layer -%d", layerNumber);
	addCommand(cmd);
}

void addViaWithDrillSize(string signalName, real drillSize, real x, real y) {
	sprintf(cmd, "change drill %0.3f", drillSize);
	addCommand(cmd);
	sprintf(cmd, "via '%s' %s", signalName, point(x, y));
	addCommand(cmd);
}

void addPowerVia(string signalName, real x, real y) {
	addViaWithDrillSize(signalName, powerViaDrillSize, x, y);
}

void addVia(string signalName, real x, real y) {
	addViaWithDrillSize(signalName, defaultViaDrillSize, x, y);
}

// brian's parts
void swap0402Label(string part) {
	UL_ELEMENT e = findBoardPartNamed(part);
	e.texts(t) {
		if (t.layer == LAYER_TNAMES) {
			sprintf(cmd, "change align top-center %s", u2mmPoint(t.x, t.y));
			addCommand(cmd);
			moveFromU2mm(t.x, t.y, u2mm(t.x), u2mm(t.y) - 1.3);
		}
	}
}
void swap0603Label(string part) {
	UL_ELEMENT e = findBoardPartNamed(part);
	e.texts(t) {
		if (t.layer == LAYER_TNAMES) {
			sprintf(cmd, "change align top-center %s", u2mmPoint(t.x, t.y));
			addCommand(cmd);
			moveFromU2mm(t.x, t.y, u2mm(t.x), u2mm(t.y) - 1.4);
		}
	}
}
