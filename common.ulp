#usage "Commonly used ULP methods"

#include "stringUtilities.ulp"

/* move a group:
	select elements
	MOVE (>0 0) (0 -40);
*/

real boardLowerLeftX = 0;
real boardLowerLeftY = 0;
real boardUpperRightX = 0;
real boardUpperRightY = 0;
real boardHeight = 0;
real boardWidth = 0;
real defaultViaDrillSize = 0.35;
// https://www.protoexpress.com/tools/via-current-capacity-temperature-rise-calculator/
// The thickness of the copper plating is 18 µm (JLCPCB)
// Board thickness 6-layer is 1.6mm
// According to calculator @ 130F a 0.8mm drill via can carry ~3.7A
real powerViaDrillSize = 0.8;

// JLCPCB specs:
real minimumAnnularRingWidth1OzCopper = 0.13;
real minimumAnnularRingWidth2OzCopper = 0.2;
real minimumAnnularRingWidthForPlatedThroughHole = 0.3;
// using minimum PTH for minimum annular ring width as it the max of all three options
real minimumAnnularRingWidth = 0.3;
real minimumBoardEdgeMargin = 0.5;
real minimumDistanceBetweenPadAndSilkscreen = 0.15;
real minimumLineWidth = 0.153;	// JLCPCB minimum line width is 0.153
real minimumPadToPadClearance = 0.127;
real minimumTextHeight = 1.0;	// JLCPCB minimum text height is 0.8, but 1.0 is barely legible
real textHeightUnitsPerWidthUnit = 6;
real jlcpcbViaCopperPlatingThickness = 18; // The thickness of the copper plating is 18 µm

string cmd = "";
string exitCommands = "";

void addCommand(string c) {
	exitCommands += c + ";";
}

string allBoardElementNamesSeparatedByNewline() {
	string result = "";
	
	project.board(b) {
		b.elements(e) {
			result += e.name + '\n';
		}
	}
	
	return result;
}

void change(string parameter, real value) {
	sprintf(cmd, "change %s %0.03f", parameter, value);
	addCommand(cmd);
}

real ceilingTo(real number, real roundTo) {
	return roundTo == 0 ? number : ceil(number / roundTo) * roundTo;
}

real floorTo(real number, real roundTo) {
	return roundTo == 0 ? number : floor(number / roundTo) * roundTo;
}

real distance(real x1, real y1, real x2, real y2) {
	real x2MinusX1 = x2 - x1;
	real y2MinusY1 = y2 - y1;
	real x2MinusX1Squared = x2MinusX1 * x2MinusX1;
	real y2MinusY1Squared = y2MinusY1 * y2MinusY1;

	return sqrt(x2MinusX1Squared + y2MinusY1Squared);
}

void editBoard() {
	addCommand("edit .brd");
}

void editSchematic() {
	addCommand("edit .sch");
}

real milToMm(real mil) {
	return mil * 0.0254;
}

real mmToMil(real mm) {
	return mm / 0.0254;
}

string partNamesWithPrefixInRangeSeparatedByNewline(string prefix, int from, int toInclusive) {
	string parts = "";

	for (int i = from; i <= toInclusive; ++i) {
		sprintf(parts, "%s%s%d\n", parts, prefix, i);
	}

	return parts;
}

string point(real x, real y) {
	string result;
	sprintf(result, "(%0.03f %0.03f)", x, y);
	return result;
}

string u2mmPoint(int x, int y) {
	return point(u2mm(x), u2mm(y));
}

void move(string partName, real toX, real toY) {
	sprintf(cmd, "move %s %s", partName, point(toX, toY));
	addCommand(cmd);
}

void moveFrom(real fromX, real fromY, real toX, real toY) {
	sprintf(cmd, "move %s %s", point(fromX, fromY), point(toX, toY));
	addCommand(cmd);
}

void moveFromU2mm(int fromX, int fromY, real toX, real toY) {
	moveFrom(u2mm(fromX), u2mm(fromY), toX, toY);
}

void drawCircle(real lineWidth, real centerX, real centerY, real radius) {
	sprintf(cmd, "circle %0.3f %s %s", lineWidth, point(centerX, centerY), point(centerX + radius, centerY));
	addCommand(cmd);
}

void drawFilledCircle(real centerX, real centerY, real radius) {
	sprintf(cmd, "circle 0 %s %s", point(centerX, centerY), point(centerX + radius, centerY));
	addCommand(cmd);
}

void drawStyledLine(real lineWidth, string style, real fromX, real fromY, real toX, real toY) {
	sprintf(cmd, "line %0.03f %s %s %s", lineWidth, style, point(fromX, fromY), point(toX, toY));
	addCommand(cmd);
}

void drawLine(real lineWidth, real fromX, real fromY, real toX, real toY) {
	drawStyledLine(lineWidth, "flat", fromX, fromY, toX, toY);
}

void drawRectangle(real upperLeftX, real upperLeftY, real lowerRightX, real lowerRightY, real lineWidth) {
	drawLine(lineWidth, upperLeftX, upperLeftY, lowerRightX, upperLeftY);
	drawLine(lineWidth, lowerRightX, upperLeftY, lowerRightX, lowerRightY);
	drawLine(lineWidth, lowerRightX, lowerRightY, upperLeftX, lowerRightY);
	drawLine(lineWidth, upperLeftX, lowerRightY, upperLeftX, upperLeftY);
}

void drawRoundedRectangle(real upperLeftX, real upperLeftY, real lowerRightX, real lowerRightY, real cornerRadius, real lineWidth) {
	real x1 = upperLeftX + cornerRadius;
	real y1 = upperLeftY;
	real x2 = lowerRightX - cornerRadius;
	real y2 = y1;
	
	drawStyledLine(lineWidth, "round", x1, y1, x2, y2);
	
	x1 = lowerRightX;
	y1 -= cornerRadius;
	
	drawStyledLine(lineWidth, "round", x2, y2, x1, y1);

	x2 = lowerRightX;
	y2 = lowerRightY + cornerRadius;
	
	drawStyledLine(lineWidth, "round", x1, y1, x2, y2);

	x1 = lowerRightX - cornerRadius;
	y1 = lowerRightY;
	
	drawStyledLine(lineWidth, "round", x2, y2, x1, y1);

	x2 = upperLeftX + cornerRadius;
	y2 = lowerRightY;
	
	drawStyledLine(lineWidth, "round", x1, y1, x2, y2);

	x1 = upperLeftX;
	y1 = lowerRightY + cornerRadius;
	
	drawStyledLine(lineWidth, "round", x2, y2, x1, y1);

	x2 = upperLeftX;
	y2 = upperLeftY - cornerRadius;
	
	drawStyledLine(lineWidth, "round", x1, y1, x2, y2);

	x1 = upperLeftX + cornerRadius;
	y1 = upperLeftY;
	
	drawStyledLine(lineWidth, "round", x2, y2, x1, y1);
}

string gridUnitToString(int unit) {
	string result = "";

	switch (unit) {
		case GRID_UNIT_MIC:		result = "microns";		break;
		case GRID_UNIT_MIL:		result = "mil";			break;
		case GRID_UNIT_MM:		result = "mm";			break;
		case GRID_UNIT_INCH:	result = "inch";		break;
	}

	return result;
}

void getBoardInfo(UL_BOARD b, int isLoggingEnabled) {
	real lowerLeftX = REAL_MAX;
	real lowerLeftY = REAL_MAX;
	real upperRightX = REAL_MIN;
	real upperRightY = REAL_MIN;
	
	// find board boundary
	b.wires(w) {
		if (w.layer != LAYER_DIMENSION) continue;
		
		lowerLeftX = min(lowerLeftX, u2mm(w.x1));
		lowerLeftX = min(lowerLeftX, u2mm(w.x2));
		lowerLeftY = min(lowerLeftY, u2mm(w.y1));
		lowerLeftY = min(lowerLeftY, u2mm(w.y2));
		upperRightX = max(upperRightX, u2mm(w.x1));
		upperRightX = max(upperRightX, u2mm(w.x2));
		upperRightY = max(upperRightY, u2mm(w.y1));
		upperRightY = max(upperRightY, u2mm(w.y2));
	}
	
	real height = upperRightY - lowerLeftY;
	real width = upperRightX - lowerLeftX;
	
	if (width > 0 && height > 0) {
		boardLowerLeftX = lowerLeftX;
		boardLowerLeftY = lowerLeftY;
		boardUpperRightX = upperRightX;
		boardUpperRightY = upperRightY;
		boardHeight = height;
		boardWidth = width;
	}

	string alwaysVectorFontAttributes = "";

	if (b.alwaysvectorfont & ALWAYS_VECTOR_FONT_GUI) {
		alwaysVectorFontAttributes += "ALWAYS_VECTOR_FONT_GUI";
	}
	if (b.alwaysvectorfont & ALWAYS_VECTOR_FONT_PERSISTENT) {
		if (strlen(alwaysVectorFontAttributes) > 0) {
			alwaysVectorFontAttributes += ", ";
		}
		alwaysVectorFontAttributes += "ALWAYS_VECTOR_FONT_PERSISTENT";
	}

	if (isLoggingEnabled) {
		printf("board info\n");
		printf("  alwaysvectorfont: " + alwaysVectorFontAttributes + "\n");
		printf("  area lower left %s, upper right %s\n", u2mmPoint(b.area.x1, b.area.y1), u2mmPoint(b.area.x2, b.area.y2));
		printf("  board width %0.02f x height %0.02f mm\n", u2mm(b.area.x2) - u2mm(b.area.x1), u2mm(b.area.y2) - u2mm(b.area.y1));
		printf("  grid %s size %0.02f %s\n", b.grid.on ? "on" : "off", b.grid.distance, gridUnitToString(b.grid.unit));
		printf("  checked: %d\n", b.checked);
		printf("  description: " + b.description + "\n");
		printf("  headline: " + b.headline + "\n");
		printf("  name: " + b.name + "\n");
		printf("  dimensioned area %s %s, w: %0.02f x h: %0.02f\n", point(lowerLeftX, lowerLeftY), point(upperRightX, upperRightY), width, height);
	}
}

string alignToString(int align) {
	string result;
	
	switch (align) {
		case ALIGN_BOTTOM_LEFT:		result = "bottom-left";			break;
		case ALIGN_BOTTOM_CENTER:	result = "bottom-center";		break;
		case ALIGN_BOTTOM_RIGHT: 	result = "bottom-right";		break;
		case ALIGN_CENTER_LEFT: 	result = "center-left";			break;
		case ALIGN_CENTER: 			result = "center";				break;
		case ALIGN_CENTER_RIGHT: 	result = "center-right";		break;
		case ALIGN_TOP_LEFT: 		result = "top-left";			break;
		case ALIGN_TOP_CENTER: 		result = "top-center";			break;
		case ALIGN_TOP_RIGHT: 		result = "top-right";			break;
		default:					result = "unknown-align";		break;
	}
	
	return result;
}

